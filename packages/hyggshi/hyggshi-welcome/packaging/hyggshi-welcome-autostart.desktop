[Desktop Entry]
Type=Application
Name=Hyggshi Welcome
Comment=First-run setup assistant for Hyggshi OS
Exec=sh -c 'test -n "$HYGGSHI_WELCOME_FORCE" || test ! -f "$HOME/.config/hyggshi/welcome-shown"; exec /usr/bin/hyggshi-welcome'
OnlyShowIn=Cinnamon;X-Cinnamon-UsesNotifications=true;
X-GNOME-Autostart-enabled=true
NoDisplay=true
